# Import these variables in Portainer's stack environment editor.

# Exact UUID from: nvidia-smi --query-gpu=uuid --format=csv,noheader
NVIDIA_GPU_ID=GPU-replace-with-the-gtx-1080-uuid

# Replace the tag with the immutable digest emitted by the release build.
# This vendor-specific image fails startup unless NVIDIA NVENC is available.
LIVE_NVIDIA_IMAGE=tztcloud/live-runner-nvidia:v2.0.0

# Runner control/API ports. Restrict 18080, 18180, and 18280 to trusted broker
# and operator addresses at the host firewall.
VOD_BIND_IP=0.0.0.0
VOD_PORT=18080
VOD_MAX_QUEUE_SIZE=1
ABR_BIND_IP=0.0.0.0
ABR_PORT=18180
ABR_MAX_QUEUE_SIZE=1
LIVE_HTTP_BIND_IP=0.0.0.0
LIVE_HTTP_PORT=18280
LIVE_RTMP_BIND_IP=0.0.0.0
LIVE_RTMP_PORT=1935

# Generate once and retain across redeployments:
#   openssl rand -base64 32
#   openssl rand -hex 32
#   openssl rand -hex 32
LIVE_RUNNER_MASTER_KEY=replace-with-base64-for-exactly-32-bytes
# Optional. The broker reaches the session routes over the pool member
# agent's tunnel and presents no bearer, so leave this unset for an
# attached runner; set it only when something other than an agent can
# reach the port. When set, >= 32 characters.
LIVE_RUNNER_BROKER_TOKEN=
LIVE_RUNNER_INTERNAL_MEDIA_TOKEN=replace-with-at-least-32-random-characters

# Direct Portainer deployment serves plain RTMP and HTTP. Replace the host with
# the server's public DNS name or address. When TLS proxies are installed, use
# rtmps:// and https:// origins and their externally reachable ports.
LIVEPEER_PUBLIC_RTMP_URL=rtmp://media.example.com:1935
LIVEPEER_PUBLIC_URL=http://media.example.com:18280
