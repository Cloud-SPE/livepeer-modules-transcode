# Copy to .env and replace the three live-runner placeholders before using a
# live-* profile. These example values are intentionally not secrets.
LIVE_RUNNER_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LIVE_RUNNER_BROKER_TOKEN=replace-with-a-broker-token-of-32-or-more-characters
LIVE_RUNNER_INTERNAL_MEDIA_TOKEN=replace-with-an-internal-token-of-32-or-more-characters

# Development defaults match infra/scripts/build-images.sh with TAG=v2.0.0.
# Production must replace every enabled profile with a registry digest, e.g.
# VOD_NVIDIA_IMAGE=registry.example/transcode-runner:v2.0.0-runtime-nvidia@sha256:...
VOD_NVIDIA_IMAGE=tztcloud/transcode-runner:v2.0.0-runtime-nvidia
VOD_INTEL_IMAGE=tztcloud/transcode-runner:v2.0.0-runtime-intel
VOD_AMD_IMAGE=tztcloud/transcode-runner:v2.0.0-runtime-amd
VOD_CPU_IMAGE=tztcloud/transcode-runner:v2.0.0-runtime-cpu
ABR_NVIDIA_IMAGE=tztcloud/abr-runner:v2.0.0-runtime-nvidia
ABR_INTEL_IMAGE=tztcloud/abr-runner:v2.0.0-runtime-intel
ABR_AMD_IMAGE=tztcloud/abr-runner:v2.0.0-runtime-amd
LIVE_NVIDIA_IMAGE=tztcloud/live-runner-nvidia:v2.0.0
LIVE_INTEL_IMAGE=tztcloud/live-runner-intel:v2.0.0
LIVE_AMD_IMAGE=tztcloud/live-runner-amd:v2.0.0
LIVE_CPU_IMAGE=tztcloud/live-runner-cpu:v2.0.0

# GPU profiles share admission files in a named volume. NVIDIA domains are
# keyed by the device below; Intel/AMD share one conservative DRI domain because
# these profiles expose the full device tree. The CPU live image also runs the
# one-shot file initializer (no CPU encoder is used by GPU runners).

# NVIDIA accepts a zero-based index for a single-card development host. Use a
# stable GPU UUID in production, matching Modules placement behavior.
NVIDIA_GPU_ID=0

# Set these to the host's video/render group IDs when /dev/dri permissions do
# not match the image defaults (`getent group video`, `getent group render`).
VIDEO_GID=44
RENDER_GID=109

# Public origins returned in live session descriptors. The defaults are for
# same-host, plain-RTMP development. Production normally uses the Modules
# member edge and rtmps://<public-host>:1936.
LIVE_NVIDIA_HTTP_BIND=127.0.0.1
LIVE_NVIDIA_PUBLIC_RTMP_URL=rtmp://127.0.0.1:1935
LIVE_NVIDIA_PUBLIC_URL=http://127.0.0.1:18280
LIVE_INTEL_HTTP_BIND=127.0.0.1
LIVE_INTEL_PUBLIC_RTMP_URL=rtmp://127.0.0.1:1936
LIVE_INTEL_PUBLIC_URL=http://127.0.0.1:18281
LIVE_AMD_HTTP_BIND=127.0.0.1
LIVE_AMD_PUBLIC_RTMP_URL=rtmp://127.0.0.1:1937
LIVE_AMD_PUBLIC_URL=http://127.0.0.1:18282
LIVE_CPU_HTTP_BIND=127.0.0.1
LIVE_CPU_PUBLIC_RTMP_URL=rtmp://127.0.0.1:1938
LIVE_CPU_PUBLIC_URL=http://127.0.0.1:18283
