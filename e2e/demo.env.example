# Copy to .env.demo, chmod 600, and supply your own service credentials.
# compose.demo.yaml reads .env.demo; do not commit the populated file.
LIVEPEER_LOC_URL=https://loc.cloudspe.com
LIVEPEER_LOC_API_KEY=
LIVEPEER_LOC_TIMEOUT_MS=30000
# Stable transcode-specific raw secp256k1 private key (64 lowercase hex).
LIVEPEER_CALLER_PRIVATE_KEY=
# Stable, separately backed-up canonical base64 encoding of 32 random bytes.
LIVEPEER_OPERATION_SECRETS_KEK=
LIVEPEER_OPERATION_SECRETS_KEY_ID=local-demo-v1
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
FROM_EMAIL=Livepeer Transcode <noreply@example.com>
LIVEPEER_GATEWAY_EXTERNAL_RTMP_URL=rtmp://localhost:1935/live
