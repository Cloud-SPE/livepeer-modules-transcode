+async def release_failed_session_preparation(
+    session: AsyncSession,
+    *,
+    user_id: uuid.UUID,
+    idempotency_key: str,
+    lease_expires_at: datetime | None,
+    clock: Clock,
+) -> None:
+    """Release only this preparation attempt; it has no payment side effects.
+
+    Preserve fingerprint and request identity. The expiry fence prevents a late
+    failed attempt from releasing a newer claimant. Never use for paid opens.
+    """
+    if lease_expires_at is None:
+        return
+    await session.execute(
+        update(PaymentIdempotencyKey)
+        .where(
+            PaymentIdempotencyKey.user_id == user_id,
+            PaymentIdempotencyKey.operation == "sessions.prepare",
+            PaymentIdempotencyKey.idempotency_key == idempotency_key,
+            PaymentIdempotencyKey.status == "in_flight",
+            PaymentIdempotencyKey.expires_at == lease_expires_at,
+        )
+        .values(expires_at=clock.now())
+        .execution_options(synchronize_session=False)
+    )
     await session.commit()
 
 
