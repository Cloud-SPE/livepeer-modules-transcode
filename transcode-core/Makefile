.PHONY: help build test vet fmt clean

help: ## Show this help.
	@grep -E '^[a-zA-Z_-]+:.*?## ' Makefile | awk 'BEGIN {FS = ":.*?## "} {printf "  \033[36m%-8s\033[0m %s\n", $$1, $$2}'

build: ## go build ./...
	go build ./...

test: ## go test ./...
	go test ./...

vet: ## go vet ./...
	go vet ./...

fmt: ## gofmt -l -w .
	gofmt -l -w .

clean: ## remove build artifacts
	go clean ./...
